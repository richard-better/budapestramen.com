---
const links = [
  { to: "/", label: "Home" },
];
---

<header class="border-b border-neutral-800">
  <div class="flex items-center justify-between gap-4 px-4 py-2 md:px-6">
    <a href="/" aria-label="Budapest Ramen home" class="flex items-center gap-3 font-semibold">
      <img src="/icon-192.png" alt="" width="48" height="48" class="size-12" />
      <span>Budapest Ramen</span>
    </a>
    <nav class="flex gap-4 text-lg">
      {links.map((link) => (
        <a href={link.to} class="text-white hover:text-neutral-400 transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
