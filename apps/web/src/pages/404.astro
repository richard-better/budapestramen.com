---
import Layout from "../layouts/Layout.astro";
import type { Language } from "../lib/guide";
import { preferredLanguage } from "../lib/language";

const pathLanguage = Astro.originPathname.match(/^\/(en|hu)(?:\/|$)/)?.[1] as Language | undefined;
const language = pathLanguage ?? preferredLanguage(Astro.request.headers.get("accept-language"));
const t = {
  en: {
    title: "Page not found - Budapest Ramen",
    heading: "No ramen here",
    body: "This page doesn't exist, but the ramen map does.",
    action: "Open the ramen map",
  },
  hu: {
    title: "Az oldal nem található - Budapest Ramen",
    heading: "Itt nincs ramen",
    body: "Ez az oldal nem létezik, de a ramen térkép igen.",
    action: "Ramen térkép megnyitása",
  },
}[language];
---

<Layout title={t.title} description={t.body} language={language} fullScreen>
  <main class="not-found">
    <a href={`/${language}`} class="brand" aria-label="Budapest Ramen home">
      <img src="/icon-192.png" width="44" height="44" alt="" /><strong>Budapest Ramen</strong>
    </a>
    <p class="code">404</p>
    <h1>{t.heading}</h1>
    <p>{t.body}</p>
    <a href={`/${language}`} class="button button-dark">{t.action}</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100dvh;
    max-width: 420px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
  }
  .brand {
    margin-bottom: 24px;
    font-size: 18px;
    font-weight: 800;
  }
  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
  .button {
    margin-top: 12px;
  }
</style>
